# Copia este archivo como .env después de ejecutar el esquema en phpMyAdmin.
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=0
APP_ORIGIN=http://127.0.0.1:5173
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=avisosur_db
DB_USER=root
DB_PASSWORD=
# DB_CLIENT=sqlite usa el respaldo existente en backend/data/avisosur.sqlite.
# DB_PATH y UPLOAD_DIR admiten rutas absolutas para entornos aislados.
# DEMO_PASSWORD solo sirve para entrar a la cuenta demo en una exposición; se aplica al crear la base SQLite.
# DEMO_PASSWORD=
# Railway proporciona PORT. En su panel configurar:
# NODE_ENV=production
# HOST=0.0.0.0
# TRUST_PROXY=1
# DB_CLIENT=mysql
# DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD desde el servicio MySQL.
# APP_ORIGIN=https://dominio-publico.up.railway.app
# Si se omite APP_ORIGIN, se utiliza RAILWAY_PUBLIC_DOMAIN cuando esté disponible.
# COOKIE_SECURE=true
# Montar un volumen en /data y configurar:
# UPLOAD_DIR=/data/uploads
# PRIVATE_UPLOAD_DIR=/data/uploads/.privado
# Las claves reales se introducen en Railway Variables.
