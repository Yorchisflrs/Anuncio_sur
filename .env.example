# Copia este archivo como .env después de ejecutar el esquema en phpMyAdmin.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=avisosur_db
DB_USER=root
DB_PASSWORD=
# DB_CLIENT=sqlite usa el respaldo existente en backend/data/avisosur.sqlite.
# DB_PATH y UPLOAD_DIR admiten rutas absolutas para entornos aislados.
# COOKIE_SECURE=true solo cuando se sirve a través de HTTPS.
